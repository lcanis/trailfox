#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

FORCE_RESET=false
IMPORT_VERB=""
PBF_FILE=""

usage() {
  cat <<'EOF'
Usage:
    ./bootstrap create|append|incremental /path/to/file.osm.pbf [--env-file path] [--bbox minlon,minlat,maxlon,maxlat]
EOF
}

if [ "$#" -ge 1 ] && ( [ "$1" = "-h" ] || [ "$1" = "--help" ] ); then
    usage
    exit 0
fi

IMPORT_VERB="${1:-}"
shift 1
PBF_FILES=()

# Collect PBF files (all arguments that don't start with -- and are not the verb)
while [ "$#" -gt 0 ]; do
    case "$1" in
        --*) break ;; # Stop at first option
        *) PBF_FILES+=("$1"); shift ;;
    esac
done

if [ -z "$IMPORT_VERB" ] || [ ${#PBF_FILES[@]} -eq 0 ]; then
    usage
    exit 2
fi

BBOX=""
SLIM=true
FLAT_NODES="/tmp/nodes.flat"

while [ "$#" -gt 0 ]; do
    case "$1" in
        --env-file)
            ENV_FILE="$2"; shift 2;;
        --bbox)
            BBOX="$2"; shift 2;;
        --no-slim)
            SLIM=false; FLAT_NODES=""; shift;;
        --slim)
            SLIM=true; shift;;
        --flat-nodes)
            FLAT_NODES="$2"; shift 2;;
        -h|--help)
            usage; exit 0;;
        *)
            echo "Unknown option: $1" >&2; usage; exit 2;;
    esac
done

# Ensure we have an env file to load unless provided by --env-file
ENV_FILE="${ENV_FILE:-$SCRIPT_DIR/.env}"

source "$SCRIPT_DIR/bootstrap-common.sh"

echo "-- create DB"
"$SCRIPT_DIR/init-user"
"$SCRIPT_DIR/init-db" $([ "$IMPORT_VERB" = "create" ] && echo "--force-reset")

echo "-- import OSM data and run post-import maintenance"
IMPORT_ARGS=()
if [ -n "$BBOX" ]; then
  IMPORT_ARGS+=(--bbox "$BBOX")
fi
if [ "$SLIM" = true ]; then
  IMPORT_ARGS+=(--slim)
  if [ -n "$FLAT_NODES" ]; then
    IMPORT_ARGS+=(--flat-nodes "$FLAT_NODES")
  fi
else
  IMPORT_ARGS+=(--no-slim)
fi

"$SCRIPT_DIR/import" "${IMPORT_ARGS[@]}" "$IMPORT_VERB" "${PBF_FILES[@]}"

echo "-- apply API/tiles schemas"
"$SCRIPT_DIR/apply-schemas"

echo "done"
