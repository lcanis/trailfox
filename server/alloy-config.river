prometheus.exporter.postgres "postgis" {
  data_source_names = [
    "postgresql://" + env("POSTGRES_USER") + ":" + encoding.url_encode(env("POSTGRES_PASSWORD")) + "@postgis:5432/itinerarius?sslmode=disable",
  ]
  enabled_collectors = ["stat_statements"]
  stat_statements {
    include_query = false
  }
}

prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "postgis" {
  targets    = prometheus.exporter.postgres.postgis.targets
  forward_to = [prometheus.remote_write.grafana.receiver]
}

prometheus.scrape "node" {
  targets    = prometheus.exporter.unix.node.targets
  forward_to = [prometheus.remote_write.grafana.receiver]
}

prometheus.remote_write "grafana" {
  endpoint {
    url = env("ALLOY_PROMETHEUS_URL")
    basic_auth {
      username = env("ALLOY_PROMETHEUS_USER")
      password = env("ALLOY_PROMETHEUS_API_TOKEN")
    }
  }
}
